{
  "build": {
    "beforeBuildCommand": "npx vite build",
    "beforeDevCommand": "npx vite",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "AI Text Replacer",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "shell": {
        "open": true
      },
      "clipboard": {
        "all": true
      },
      "globalShortcut": {
        "all": true
      },
      "window": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "identifier": "com.aitextreplacer.app",
      "icon": ["icons/icon.png", "icons/icon.ico"]
    },
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false
    },
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "resizable": true,
        "title": "AI Text Replacer",
        "width": 900,
        "height": 640,
        "minWidth": 480,
        "minHeight": 360
      },
      {
        "label": "popup",
        "url": "index.html?view=popup",
        "title": "AI Text Replacer",
        "width": 360,
        "height": 320,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "toast",
        "url": "index.html?view=toast",
        "title": "AI Text Replacer",
        "width": 168,
        "height": 34,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
